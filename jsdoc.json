{
    "source":{
        "include":["scripts/pages"],
        "includePattern": ".js$",
        "excludePattern": "node_modules/|docs"
    },
    "plugins": ["plugins/markdown"],
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": true
    },
    "opts": {
        "recirse": true,
        "destination": "./docs/"
    }
}